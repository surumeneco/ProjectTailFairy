{
  "name": "project-tail-fairy",
  "version": "0.1.0",
  "private": true,
  "description": "Self-organizing AGI agent based on Spiking Neural Networks",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:model": "pnpm --filter @project-tail-fairy/model test",
    "test:numpy": "pnpm --filter @project-tail-fairy/numpy-ts test",
    "test:scipy": "pnpm --filter @project-tail-fairy/scipy-ts test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.10.0",
    "@webgpu/types": "^0.1.40",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
