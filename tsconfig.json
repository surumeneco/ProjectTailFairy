{
  "files": [],
  "references": [
    {
      "path": "./TranslatedLibraries/NumPyTs"
    },
    {
      "path": "./TranslatedLibraries/SciPyTs"
    },
    {
      "path": "./Model"
    }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "exclude": ["node_modules", "dist"]
}
