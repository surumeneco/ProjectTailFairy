{
  "files": [],
  "references": [
    {
      "path": "./TranslatedLibraries/NumPyTs"
    },
    {
      "path": "./TranslatedLibraries/SciPyTs"
    },
    {
      "path": "./Model"
    }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@project-tail-fairy/numpy-ts": ["./TranslatedLibraries/NumPyTs/src/index.ts"],
      "@project-tail-fairy/numpy-ts/*": ["./TranslatedLibraries/NumPyTs/src/*"],
      "@project-tail-fairy/scipy-ts": ["./TranslatedLibraries/SciPyTs/src/index.ts"],
      "@project-tail-fairy/scipy-ts/*": ["./TranslatedLibraries/SciPyTs/src/*"],
      "@project-tail-fairy/model": ["./Model/src/index.ts"],
      "@project-tail-fairy/model/*": ["./Model/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "exclude": ["node_modules", "dist"]
}
